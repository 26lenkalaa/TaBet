# Copy to backend/.env for local development. Never commit .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Read-only key for the API (Supabase: Project Settings -> API Keys -> Publishable key)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only needed for `npm run sync` (Secret key). Keep it out of the browser and out of git.
SUPABASE_SECRET_KEY=sb_secret_...
