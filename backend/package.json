{
  "name": "tabet-backend",
  "private": true,
  "version": "1.0.0",
  "description": "TaBet API (Express on Vercel) and Supabase sync",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "sync": "node --env-file-if-exists=.env scripts/sync-soccer.mjs",
    "test": "node --test \"test/*.test.js\"",
    "site": "node --env-file-if-exists=.env scripts/dev-site.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13"
  }
}
